# ==============================================================================
#  .env.example — шаблон переменных окружения проекта
# ==============================================================================
#  Это ПРИМЕР, безопасный для коммита. Реальный .env (с настоящими значениями)
#  в git НЕ коммитится — он доставляется на сервер через секрет ENV_FILE
#  (см. README → «Управление .env»).
#
#  Как использовать:
#    1. Скопируй под конкретный проект:   cp .env.example proj1.env
#    2. Заполни реальными значениями.
#    3. Загрузи в секрет при онбординге:  ./onboard-project.sh owner/proj1 ./proj1.env
# ==============================================================================

# --- Приложение ---
APP_ENV=production
APP_PORT=8000

# --- База данных ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Внешние сервисы / токены ---
API_TOKEN=
