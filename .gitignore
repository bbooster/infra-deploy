# ==============================================================================
#  .gitignore — защита от случайного коммита секретов в этот репозиторий
# ==============================================================================
#  В этом репо лежат только скрипты, шаблон workflow и документация.
#  Реальные секреты (.env, приватные ключи) сюда попадать НЕ должны.
#  Эти правила — страховка на случай, если ты положишь их в папку рядом.
# ==============================================================================

# .env и любые его вариации (кроме примера)
*.env
.env
.env.*
!.env.example
!*.env.example

# каталог, куда удобно складывать .env-файлы проектов локально
secrets/

# приватные SSH-ключи (служебный и deploy key)
*.pem
*.key
id_ed25519*
id_rsa*
actions_deploy
actions_deploy.pub
deploy_*

# ключ SOPS/age (если будешь использовать шифрование .env)
key.txt
*.agekey

# системный мусор
.DS_Store
*.swp
